    },
    {
      "entryId": "isa-52-11",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "The vessel-bearers exit Babylon clean. First principle: separation is sanctification's address — and Revelation replays the call as Babylon falls again.",
      "density": 1.4393,
      "words": 21,
      "sentences": 2,
      "maxSentenceWords": 16,
      "gate": "PASS",
      "violations": [],
      "context": {
        "citations": []
      }
    },
    {
