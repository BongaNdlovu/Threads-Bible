    {
      "entryId": "ezr-7-10",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Seek, do, teach — the prepared-heart sequence. First principle: the scribe's triad is the ministry's order — seeking precedes doing, doing precedes teaching.",
