    },
    {
      "entryId": "dan-12-3",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Those who turn many to righteousness shall shine as the stars. First principle: faithful witness yields glory in the resurrection life.",
      "density": 1.1536,
      "words": 21,
      "sentences": 2,
      "maxSentenceWords": 11,
      "gate": "PASS",
      "violations": [],
