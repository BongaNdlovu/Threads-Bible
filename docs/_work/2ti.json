  "fields": [
    {
      "entryId": "2ti-1-9",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Saved by purpose and grace, not works — the grace predates time. First principle: pre-creation grace in Christ Jesus is the ground of the present holy calling; Ephesians 1 and 2 Timothy 1 handshake across the canon.",
      "density": 2.3536,
      "words": 37,
      "sentences": 2,
      "maxSentenceWords": 25,
      "gate": "PASS",
      "violations": [],
      "context": {
