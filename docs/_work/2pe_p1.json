    {
      "entryId": "2pe-1-19",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Prophecy is the lamp in the dark place until the Day dawns. First principle: the transfigured Mount certifies the written word — the shining day-star is the goal the lamp serves until morning.",
      "density": 2.025,
      "words": 33,
      "sentences": 2,
      "maxSentenceWords": 21,
