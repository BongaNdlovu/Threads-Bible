    },
    {
      "entryId": "2pe-2-22",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "The true proverb judges false teachers' relapse. First principle: nature reverts where nature is unchanged — washing the outside of the sow does not re-create the sow.",
      "density": 1.8179,
      "words": 27,
      "sentences": 2,
