      }
    },
    {
      "entryId": "2pe-3-10",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Heavens pass with noise; elements melt; earth burned. First principle: the thief-day ends in cosmic renovation — the works in it are the fuel, the promise is the new earth.",
      "density": 2.0071,
      "words": 30,
      "sentences": 2,
      "maxSentenceWords": 22,
      "gate": "PASS",
