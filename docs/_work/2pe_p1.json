      }
    },
    {
      "entryId": "2pe-1-21",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Prophecy's origin is divine motion, not human will. First principle: the authorship doctrine in one sentence — carried men spoke; the wind of God moved the sails of the writers.",
      "density": 2.0071,
      "words": 30,
      "sentences": 2,
      "maxSentenceWords": 22,
      "gate": "PASS",
