    },
    {
      "entryId": "ecc-7-20",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Who doeth good and sinneth not. First principle: the universal-sin text of the wisdom canon — Romans 3 builds its none-righteous catena partly on this line.",
      "density": 1.7929,
      "words": 26,
      "sentences": 2,
      "maxSentenceWords": 20,
      "gate": "PASS",
