    },
    {
      "entryId": "ecc-12-7",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Dust to dust; the spirit to God who gave it. First principle: the twofold destiny of man at death — body to soil, spirit to the Giver; Genesis 2:7 in reverse.",
      "density": 1.975,
      "words": 31,
      "sentences": 2,
      "maxSentenceWords": 21,
      "gate": "PASS",
      "violations": [],
