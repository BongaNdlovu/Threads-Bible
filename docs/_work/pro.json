    {
      "entryId": "pro-8-22",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Wisdom speaks as preexistent to creation. First principle: the personified Wisdom of Proverbs 8 is the background music of John 1 and Colossians 1 — the Son is the wisdom by whom all was made.",
      "density": 2.5321,
      "words": 35,
      "sentences": 2,
      "maxSentenceWords": 29,
      "gate": "PASS",
      "violations": [],
      "context": {
