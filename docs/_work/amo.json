    {
      "entryId": "amo-8-9",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Noon-darkness on a clear day, in that day. First principle: the judgment-sign of a darkened noon was fulfilled at the sixth-to-ninth hour of the cross.",
