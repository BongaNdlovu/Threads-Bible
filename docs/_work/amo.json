    {
      "entryId": "amo-9-9",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "For, lo, I will command, and I will sift the house of Israel among all nations, like as corn is sifted in a sieve, yet shall not the least grain fall upon the earth. The shaking in the remnant church tests every believer with trial, persecution, and deceptive winds of doctrine. Only genuine wheat remains in the sieve; chaff is blown away.",
      "density": 3.4929,
      "words": 62,
      "sentences": 3,
      "maxSentenceWords": 34,
      "gate": "PASS",
