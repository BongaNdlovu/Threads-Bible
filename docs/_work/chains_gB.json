      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[0].connection",
      "text": "Earliest cry of the righteous sufferer quoted by Jesus on the cross."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[0].title",
      "text": "My God, why hast Thou forsaken Me?"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[1].connection",
      "text": "Same-OT: a specific prophecy that his body would be pierced and his clothes divided."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[1].title",
      "text": "They pierced My hands and feet; cast lots for garments"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[2].connection",
      "text": "Same-OT: the righteous one suffers and is offered a bitter drink."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[2].title",
      "text": "Gall for food, vinegar for thirst"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[3].title",
      "text": "I gave my back to the smiters, my cheeks to those plucking the beard"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[3].connection",
      "text": "Same-OT: he chose to submit to public shame and violence."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[4].connection",
      "text": "Same-OT: the Servant bears sin in the place of others."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[4].title",
      "text": "Wounded for our transgressions, healed by His stripes"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[5].connection",
      "text": "Same-OT: divine Speaker pierced; mourning as for an only son."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[5].title",
      "text": "Look on Me whom they have pierced"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[6].connection",
      "text": "Same-OT: the Shepherd, who is YHWH's close Companion, is struck down."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[7].connection",
      "text": "NT: crucifixion fulfills Ps 22, Ps 69, Isa 50, and Isa 53 in detail."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[8].connection",
      "text": "NT: John cites Zechariah 12:10 and Exodus 12:46."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[9].connection",
      "text": "NT: apostolic proclamation centers on the sheep led to slaughter."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "name",
      "text": "The Suffering Servant and Pierced Messiah"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[6].title",
      "text": "Awake, O sword, against My Shepherd"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[7].title",
      "text": "The cross of Jesus Christ"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[8].title",
      "text": "Soldier pierces His side"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[9].title",
      "text": "Philip preaches Jesus from Isaiah 53"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[10].title",
      "text": "His own self bare our sins on the tree"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[10].connection",
      "text": "Peter applies Isaiah 53 to what Christ did in our place."
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[11].title",
      "text": "Every eye shall see Him, and they who pierced Him"
    },
    {
      "entryId": "chain:suffering-servant-pierced",
      "field": "steps[11].connection",
      "text": "The pierced King appears at the end of the story."
    },
