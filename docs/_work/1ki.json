    {
      "entryId": "1ki-17-1",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Elijah the Tishbite announces the drought before Ahab. First principle: the prophet's word controls the sky — James lifts Elijah as the proof that praying men like us move weather.",
      "density": 2.0071,
      "words": 30,
      "sentences": 2,
