    },
    {
      "entryId": "1ki-8-27",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Heaven of heavens cannot contain Him — how much less this house. First principle: the temple-dedication knows its own limit; the Incarnation is the surprising answer to the impossible question.",
      "density": 1.7786,
      "words": 30,
      "sentences": 2,
      "maxSentenceWords": 18,
