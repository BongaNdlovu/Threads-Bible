    },
    {
      "entryId": "1ki-17-9",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "A widow of Zidon commanded to sustain the prophet. First principle: God sends the needy to the needier — the Gentile widow's barrel becomes the stage for resurrection faith.",
      "density": 1.8679,
      "words": 29,
      "sentences": 2,
      "maxSentenceWords": 20,
      "gate": "PASS",
