    {
      "entryId": "1ki-19-21",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Elisha burns the plowing gear and follows. First principle: the call answered is irreversible — oxen cooked on their own yoke; the old life becomes the farewell feast.",
      "density": 1.9,
      "words": 28,
      "sentences": 2,
