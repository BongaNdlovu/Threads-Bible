    },
    {
      "entryId": "1ki-18-21",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Limping between LORD and Baal, and the people answer not a word. First principle: divided worship is limping worship — the choice is posed with silence as the worst answer.",
      "density": 1.7786,
      "words": 30,
      "sentences": 2,
