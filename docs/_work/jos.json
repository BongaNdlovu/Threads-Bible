    {
      "entryId": "jos-24-19",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Joshua blocks cheap commitment — a jealous God will not forgive presumptive covenant. First principle: the LORD wants informed covenant, not enthusiast vows; holiness makes service impossible to the self-confident.",
      "density": 1.7214,
      "words": 30,
      "sentences": 2,
