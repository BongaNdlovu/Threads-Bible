  "fields": [
    {
      "entryId": "1pe-2-24",
      "file": "bookThreadDetails",
      "field": "principle",
      "text": "Who his own self bare our sins in his own body on the tree. Textual proof: Isaiah 53:4-6, 12 quoted and applied; 1 Pet 1:19 — precious blood of Christ as of a lamb without blemish (Exod 12:5).",
      "density": 2.3214,
      "words": 38,
      "sentences": 2,
      "maxSentenceWords": 24,
