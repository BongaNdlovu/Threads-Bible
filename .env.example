# Threads Bible needs no API keys — the app is fully static and all data ships
# with the repository (public/books, public/data/tsk). This file documents the
# optional environment variables for local tooling only.

# PORT: port for the local dev/test server (npm run server). Default: 3000.
PORT=3000

# HOST: bind address for the dev/test server. Default: 127.0.0.1 (localhost).
# Set to 0.0.0.0 only to reach the dev server from another device on your LAN.
HOST=127.0.0.1

# BASE_PATH: override the base path at build time. Production defaults to
# /Threads-Bible/ for GitHub Pages; leave unset for local dev.
# BASE_PATH=/Threads-Bible/
